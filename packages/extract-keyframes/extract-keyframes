#!/usr/bin/env python3

import argparse
from dataclasses import dataclass
import json
import math
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile

import numpy as np


ANALYSIS_WIDTH = 192
ANALYSIS_HEIGHT = 108
REGION_SIZE = 12
SELECT_EXPR_GROUP_SIZE = 32
PTS_RE = re.compile(r"\bpts_time:([-+0-9.eE]+)")


@dataclass(frozen=True)
class Frame:
    index: int
    timestamp_seconds: float
    change_score: float | None


class FfmpegError(RuntimeError):
    pass


def positive_int(value: str) -> int:
    parsed = int(value)
    if parsed < 1:
        raise argparse.ArgumentTypeError("must be at least 1")
    return parsed


def threshold_float(value: str) -> float:
    parsed = float(value)
    if not math.isfinite(parsed) or not 0 <= parsed <= 1:
        raise argparse.ArgumentTypeError("must be between 0 and 1")
    return parsed


def parse_args(argv=None):
    parser = argparse.ArgumentParser(
        prog="extract-keyframes",
        description="Keep frames when a region changes relative to the last kept frame.",
    )
    parser.add_argument("input", type=Path, help="input video path")
    parser.add_argument("-o", "--out-dir", required=True, type=Path)
    parser.add_argument(
        "--change-threshold", type=threshold_float, default=0.27,
        help="regional mean RGB difference, from 0 to 1 (default: 0.27; lower keeps more)",
    )
    parser.add_argument("--max-dim", type=positive_int, default=1024)
    parser.add_argument("--quality", type=positive_int, default=3)
    parser.add_argument(
        "--max-frames", type=positive_int,
        help="optional safety limit; fail instead of discarding frames (default: unlimited)",
    )
    parser.add_argument("-v", "--verbose", action="store_true")
    return parser.parse_args(argv)


def regional_change(reference: np.ndarray, current: np.ndarray) -> float:
    delta = np.abs(current.astype(np.int16) - reference.astype(np.int16))
    regions = delta.reshape(
        ANALYSIS_HEIGHT // REGION_SIZE, REGION_SIZE,
        ANALYSIS_WIDTH // REGION_SIZE, REGION_SIZE, 3,
    )
    return float(regions.mean(axis=(1, 3, 4)).max() / 255)


class ChangeSelector:
    def __init__(self, threshold: float):
        self.threshold = threshold
        self.reference = None

    def consider(self, current: np.ndarray) -> tuple[bool, float | None]:
        score = None if self.reference is None else regional_change(self.reference, current)
        keep = score is None or score > self.threshold
        if keep:
            self.reference = current.copy()
        return keep, score


def detect_frames(input_path: Path, threshold: float, limit: int | None):
    selector = ChangeSelector(threshold)
    selected = []
    frame_count = 0
    frame_bytes = ANALYSIS_WIDTH * ANALYSIS_HEIGHT * 3
    vf = f"setpts=PTS-STARTPTS,scale={ANALYSIS_WIDTH}:{ANALYSIS_HEIGHT},format=rgb24,showinfo"
    with tempfile.TemporaryFile(mode="w+b") as log:
        process = subprocess.Popen(
            [
                "ffmpeg", "-hide_banner", "-nostdin", "-i", str(input_path),
                "-map", "0:v:0", "-vf", vf, "-fps_mode", "passthrough",
                "-an", "-f", "rawvideo", "-pix_fmt", "rgb24", "-",
            ],
            stdout=subprocess.PIPE, stderr=log,
        )
        try:
            while data := process.stdout.read(frame_bytes):
                if len(data) != frame_bytes:
                    raise FfmpegError("analysis returned an incomplete frame")
                current = np.frombuffer(data, dtype=np.uint8).reshape(
                    ANALYSIS_HEIGHT, ANALYSIS_WIDTH, 3
                )
                keep, score = selector.consider(current)
                if keep:
                    selected.append((frame_count, score))
                    if limit is not None and len(selected) > limit:
                        raise FfmpegError(
                            f"more than {limit} frames qualify; increase --max-frames "
                            "or omit it to keep every qualifying frame"
                        )
                frame_count += 1
            returncode = process.wait()
        finally:
            process.stdout.close()
            if process.poll() is None:
                process.kill()
            process.wait()
        log.seek(0)
        stderr = log.read().decode(errors="replace")
        if returncode:
            raise FfmpegError(stderr)

    timestamps = [float(match.group(1)) for match in PTS_RE.finditer(stderr)]
    if len(timestamps) != frame_count:
        raise FfmpegError("analysis frame count does not match its timestamps")
    if not selected:
        raise FfmpegError("ffmpeg decoded no video frames from the input")
    return [Frame(index, timestamps[index], score) for index, score in selected], frame_count


def frame_filename(frame: Frame) -> str:
    total_ms = int(round(frame.timestamp_seconds * 1000))
    minutes, remainder = divmod(total_ms, 60_000)
    seconds, millis = divmod(remainder, 1000)
    return f"frame_{minutes:02d}-{seconds:02d}-{millis:03d}_{frame.index:06d}.jpg"


def grouped_sum(terms: list[str]) -> str:
    while len(terms) > SELECT_EXPR_GROUP_SIZE:
        terms = [
            "(" + "+".join(terms[i : i + SELECT_EXPR_GROUP_SIZE]) + ")"
            for i in range(0, len(terms), SELECT_EXPR_GROUP_SIZE)
        ]
    return "+".join(terms)


def extract_frames(input_path: Path, frames: list[Frame], max_dim: int, quality: int, out_dir: Path):
    scale = (
        f"scale='min({max_dim},iw)':'min({max_dim},ih)':"
        "force_original_aspect_ratio=decrease"
    )
    with tempfile.TemporaryDirectory(prefix=".extract-", dir=out_dir) as tmp:
        tmp_dir = Path(tmp)
        expression = grouped_sum([f"eq(n,{frame.index})" for frame in frames])
        filter_path = tmp_dir / "select.txt"
        filter_path.write_text(f"select='{expression}',{scale}")
        completed = subprocess.run(
            [
                "ffmpeg", "-hide_banner", "-nostdin", "-loglevel", "error",
                "-i", str(input_path), "-map", "0:v:0",
                "-/filter:v", str(filter_path), "-fps_mode", "passthrough",
                "-an", "-pix_fmt", "yuvj420p", "-q:v", str(quality),
                str(tmp_dir / "%09d.jpg"),
            ],
            stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
        )
        if completed.returncode:
            raise FfmpegError(completed.stderr)
        files = sorted(tmp_dir.glob("*.jpg"))
        if len(files) != len(frames):
            raise FfmpegError(f"expected {len(frames)} frames, extracted {len(files)}")
        for frame, path in zip(frames, files):
            path.replace(out_dir / frame_filename(frame))


def write_sidecar(out_dir: Path, frames: list[Frame], analyzed: int, threshold: float):
    payload = {
        "meta": {
            "analyzed_count": analyzed,
            "selected_count": len(frames),
            "change_threshold": threshold,
            "analysis_width": ANALYSIS_WIDTH,
            "analysis_height": ANALYSIS_HEIGHT,
            "region_size": REGION_SIZE,
        },
        "frames": [
            {
                "filename": frame_filename(frame),
                "frame_index": frame.index,
                "timestamp_seconds": frame.timestamp_seconds,
                "change_score": frame.change_score,
                "source": "initial" if frame.index == 0 else "change",
            }
            for frame in frames
        ],
    }
    (out_dir / "frames.json").write_text(json.dumps(payload, indent=2) + "\n")


def main(argv=None) -> int:
    args = parse_args(argv)
    try:
        if shutil.which("ffmpeg") is None:
            raise FfmpegError("ffmpeg not found in PATH")
        if args.out_dir.exists() and any(args.out_dir.iterdir()):
            raise FfmpegError("output directory must be empty to avoid mixing extraction results")
        frames, analyzed = detect_frames(args.input, args.change_threshold, args.max_frames)
        args.out_dir.mkdir(parents=True, exist_ok=True)
        extract_frames(args.input, frames, args.max_dim, args.quality, args.out_dir)
        write_sidecar(args.out_dir, frames, analyzed, args.change_threshold)
        if args.verbose:
            print(f"analyzed={analyzed} kept={len(frames)} skipped={analyzed - len(frames)}")
        return 0
    except (FfmpegError, OSError) as exc:
        print(str(exc), file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
